<Window
    x:Class="FluentConnect.UI.ConnectionPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="PopupRoot" Background="Transparent" Opacity="0" PointerPressed="PopupRoot_PointerPressed">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="RootTransform" CenterX="200" CenterY="178" />
        </Grid.RenderTransform>

        <Border x:Name="Card"
                Margin="0"
                Padding="24,24,24,22"
                CornerRadius="16"
                Background="{ThemeResource PopupCardBrush}">
            <Grid RowDefinitions="Auto,18,*,18,Auto">
                <StackPanel Grid.Row="0" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="DeviceNameText"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="21"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TitleTransform" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>

                <Grid Grid.Row="2" Height="238">
                    <Ellipse x:Name="Illumination" Width="220" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="{ThemeResource SystemAccentColorLight2}" Opacity="0">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="GlowTransform" CenterX="110" CenterY="90" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Grid x:Name="ArtworkHost" Width="328" Height="218" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RenderTransform>
                            <CompositeTransform x:Name="ArtworkTransform" CenterX="164" CenterY="109" />
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="LeftArtwork" Grid.Column="0">
                            <Grid.RenderTransform>
                                <CompositeTransform x:Name="LeftArtworkTransform" CenterX="73" CenterY="98" />
                            </Grid.RenderTransform>
                            <Image x:Name="LeftDeviceArtwork" Stretch="Uniform" MaxWidth="138" MaxHeight="186" />
                            <FontIcon x:Name="LeftFallbackArtwork" Glyph="&#xE95B;" FontFamily="Segoe Fluent Icons"
                                      FontSize="74" Opacity="0.82" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <Grid x:Name="RightArtwork" Grid.Column="2">
                            <Grid.RenderTransform>
                                <CompositeTransform x:Name="RightArtworkTransform" CenterX="73" CenterY="98" />
                            </Grid.RenderTransform>
                            <Image x:Name="RightDeviceArtwork" Stretch="Uniform" MaxWidth="138" MaxHeight="186" />
                            <FontIcon x:Name="RightFallbackArtwork" Glyph="&#xE95B;" FontFamily="Segoe Fluent Icons"
                                      FontSize="74" Opacity="0.82" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>

                <StackPanel x:Name="BatteryRow" Grid.Row="4" Orientation="Horizontal" Spacing="7"
                            HorizontalAlignment="Center">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="BatteryTransform" />
                    </StackPanel.RenderTransform>
                    <TextBlock Text="Battery Charge:" FontFamily="Segoe UI" FontSize="14"
                               Foreground="{ThemeResource PopupSecondaryBrush}" />
                    <FontIcon x:Name="BatteryIcon" FontFamily="Segoe Fluent Icons" FontSize="15"
                              Foreground="{ThemeResource PopupSecondaryBrush}" />
                    <TextBlock x:Name="BatteryText" FontFamily="Segoe UI" FontSize="14"
                               Foreground="{ThemeResource PopupSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
