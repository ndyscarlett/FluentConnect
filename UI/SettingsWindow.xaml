<Window
    x:Class="FluentConnect.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Width="20" Height="20" Source="/Assets/FluentConnect.png" />
                <TextBlock Text="FluentConnect" FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="28,18,28,24" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Quiet, native connection motion for your audio devices."
                               Opacity="0.68" FontSize="14" TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="18" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{ThemeResource SettingsCardBorderBrush}"
                        Background="{ThemeResource SettingsCardBrush}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Device detection" FontSize="16" FontWeight="SemiBold" />
                        <CheckBox x:Name="AnyAudioDeviceCheckBox" Content="Any Audio Device" />
                        <TextBlock Margin="28,-8,0,0" Opacity="0.68" FontSize="13" TextWrapping="Wrap"
                                   Text="When disabled, connection animations are shown only for Microsoft Surface audio devices." />
                        <Rectangle Height="1" Fill="{ThemeResource SettingsDividerBrush}" Margin="0,2" />
                        <CheckBox x:Name="ShowAnimationCheckBox" Content="Show connection animation" />
                        <CheckBox x:Name="ShowBatteryCheckBox" Content="Show battery level when available" />
                        <CheckBox x:Name="RunAtStartupCheckBox" Content="Run at startup" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="5">
                    <TextBlock Text="FluentConnect v1.0" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="© 2026 Andy Scarlett. All rights reserved." FontSize="12" Opacity="0.68" />
                    <TextBlock Text="Microsoft and Surface are trademarks of the Microsoft group of companies. FluentConnect is an independent project and is not affiliated with, endorsed by, or sponsored by Microsoft Corporation."
                               FontSize="11" Opacity="0.58" TextWrapping="Wrap" MaxWidth="500" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Content="Check for updates" Click="CheckForUpdates_Click" />
                    <Button Content="Test animation" Click="TestAnimation_Click" />
                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
